{% set fmx_logo %}{{ include('@FullmetrixPlugin/admin/_logo_uri.html.twig')|trim }}{% endset %}

<div style="max-width:760px;margin:24px auto;padding:0 16px;font-family:inherit;">

    <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px;margin-bottom:20px;">
        <div style="display:flex;align-items:center;gap:16px;padding-bottom:16px;border-bottom:1px solid #f0f0f0;margin-bottom:{{ registered ? 18 : 22 }}px;">
            <img src="{{ fmx_logo }}" alt="Fullmetrix" style="width:52px;height:52px;border-radius:13px;box-shadow:0 1px 4px rgba(0,0,0,0.12);" />
            <div style="flex:1;min-width:0;">
                <div style="font-size:21px;font-weight:700;color:#1a1a1a;line-height:1.2;">Fullmetrix</div>
                <div style="font-size:13px;color:#6b7280;margin-top:3px;">E-commerce analytics and reporting</div>
            </div>
            {% if registered %}
                <span style="display:inline-flex;align-items:center;gap:7px;background:#e8f6ee;color:#1a8245;font-size:13px;font-weight:600;padding:8px 16px;border-radius:999px;white-space:nowrap;">
                    <span style="width:9px;height:9px;border-radius:999px;background:#1a8245;"></span>Connected
                </span>
            {% endif %}
        </div>

        {% if registered %}
            <label for="fullmetrix-code" style="display:block;font-size:14px;font-weight:600;color:#374151;margin-bottom:8px;">Connection code</label>
            <form action="{{ path('fullmetrix_admin_disconnect') }}" method="post" style="margin:0;display:flex;gap:10px;align-items:stretch;">
                <input type="text" id="fullmetrix-code" value="{{ connection_code }}" readonly
                       style="flex:1;min-width:0;box-sizing:border-box;height:50px;font-family:monospace;font-size:16px;letter-spacing:1px;background:#f8f9fa;border:1px solid #dfe3e8;border-radius:8px;padding:0 16px;color:#333;" />
                <button type="submit"
                        style="height:50px;padding:0 22px;font-size:14px;font-weight:600;white-space:nowrap;background:#fff;border:1px solid #dfe3e8;border-radius:8px;color:#374151;cursor:pointer;">Disconnect</button>
            </form>
        {% else %}
            {% if error %}
                <div style="background:#fef2f2;color:#b91c1c;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:16px;">Connection failed: {{ error }}</div>
            {% endif %}

            <ol style="list-style:none;margin:0 0 22px;padding:0;">
                {% for step in [
                    'Create your Fullmetrix account at fullmetrix.com',
                    'Copy the connection code shown in your Fullmetrix dashboard',
                    'Paste the code below and click Connect'
                ] %}
                    <li style="display:flex;align-items:flex-start;gap:12px;margin-bottom:{{ loop.last ? 0 : 14 }}px;">
                        <span style="flex-shrink:0;width:26px;height:26px;border-radius:999px;background:#2469fe;color:#fff;font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center;">{{ loop.index }}</span>
                        <span style="font-size:14px;color:#333;line-height:1.5;padding-top:2px;">{{ step }}</span>
                    </li>
                {% endfor %}
            </ol>

            <label for="fullmetrix-connect-code" style="display:block;font-size:14px;font-weight:600;color:#374151;margin-bottom:8px;">Connection code</label>
            <form action="{{ path('fullmetrix_admin_connection') }}" method="post" style="margin:0;display:flex;gap:10px;align-items:stretch;">
                <input type="text" id="fullmetrix-connect-code" name="connection_code" value="{{ submitted_code }}"
                       placeholder="FMTX-XXXX-XXXX-XXXX" required
                       pattern="FMTX-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}"
                       style="flex:1;min-width:0;box-sizing:border-box;height:52px;font-family:monospace;font-size:16px;letter-spacing:1px;background:#fff;border:1px solid #dfe3e8;border-radius:8px;padding:0 16px;color:#333;" />
                <button type="submit"
                        style="height:52px;background:#2469fe;border:1px solid #2469fe;color:#fff;font-weight:600;font-size:15px;padding:0 30px;border-radius:8px;cursor:pointer;white-space:nowrap;">Connect</button>
            </form>
        {% endif %}
    </div>

    {% if registered %}
        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px;margin-bottom:20px;">
            <h3 style="margin:0 0 16px;padding:0;border:0;font-size:18px;font-weight:700;color:#1a1a1a;">Sync activity</h3>

            {% if sync_in_progress %}
                <span style="display:inline-flex;align-items:center;gap:8px;background:#e7f0ff;color:#2469fe;font-size:13px;font-weight:600;padding:8px 16px;border-radius:999px;">
                    <span style="width:9px;height:9px;border-radius:999px;background:#2469fe;"></span>Sync in progress
                </span>
            {% elseif last_sync %}
                <span style="display:inline-flex;align-items:center;gap:8px;background:#e8f6ee;color:#1a8245;font-size:13px;font-weight:600;padding:8px 16px;border-radius:999px;">
                    <span style="width:9px;height:9px;border-radius:999px;background:#1a8245;"></span>Sync complete
                </span>

                {% if last_sync.entities is defined and last_sync.entities is iterable %}
                    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:18px;">
                        {% for label, count in last_sync.entities %}
                            {% if count > 0 %}
                                <div style="text-align:center;background:#f8f8f8;border:1px solid #e0e0e0;border-radius:8px;padding:10px 16px;min-width:80px;">
                                    <div style="font-size:20px;font-weight:700;color:#1a1a1a;line-height:1.2;">{{ count|number_format(0, ',', ' ') }}</div>
                                    <div style="font-size:11px;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;margin-top:4px;">{{ label }}</div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            {% else %}
                <span style="display:inline-flex;align-items:center;gap:8px;background:#f3f4f6;color:#6b7280;font-size:13px;font-weight:600;padding:8px 16px;border-radius:999px;">
                    <span style="width:9px;height:9px;border-radius:999px;background:#9ca3af;"></span>Waiting for sync
                </span>
            {% endif %}
        </div>

        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                <h3 style="margin:0;padding:0;border:0;font-size:18px;font-weight:700;color:#1a1a1a;">Recent activity</h3>
                {% if logs is not empty %}
                    <form action="{{ path('fullmetrix_admin_logs_clear') }}" method="post" style="margin:0;">
                        <button type="submit" style="height:34px;padding:0 14px;font-size:13px;font-weight:600;background:#fff;border:1px solid #dfe3e8;border-radius:8px;color:#374151;cursor:pointer;">Clear logs</button>
                    </form>
                {% endif %}
            </div>

            {% if logs is empty %}
                <p style="margin:0;font-size:14px;color:#6b7280;">No activity recorded yet.</p>
            {% else %}
                <table style="width:100%;border-collapse:collapse;font-size:13px;">
                    <thead>
                        <tr>
                            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid #e5e7eb;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;">When</th>
                            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid #e5e7eb;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;">Type</th>
                            <th style="text-align:left;padding:8px 10px;border-bottom:1px solid #e5e7eb;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;">Message</th>
                            <th style="text-align:right;padding:8px 10px;border-bottom:1px solid #e5e7eb;font-size:11px;font-weight:600;color:#6b7280;text-transform:uppercase;letter-spacing:0.5px;">Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for log in logs %}
                            <tr>
                                <td style="padding:8px 10px;border-bottom:1px solid #f0f0f0;color:#6b7280;white-space:nowrap;">{{ log.created_at }}</td>
                                <td style="padding:8px 10px;border-bottom:1px solid #f0f0f0;">
                                    {% set tone = {
                                        'registered': ['#e8f6ee', '#1a8245'],
                                        'sync_complete': ['#e8f6ee', '#1a8245'],
                                        'sync_start': ['#e7f0ff', '#2469fe'],
                                        'command': ['#e7f0ff', '#2469fe'],
                                        'sync_error': ['#fef2f2', '#b91c1c']
                                    }[log.type]|default(['#f3f4f6', '#6b7280']) %}
                                    <span style="display:inline-block;padding:2px 10px;border-radius:999px;font-size:11px;font-weight:600;background:{{ tone[0] }};color:{{ tone[1] }};">{{ log.type }}</span>
                                </td>
                                <td style="padding:8px 10px;border-bottom:1px solid #f0f0f0;color:#333;">{{ log.message }}</td>
                                <td style="padding:8px 10px;border-bottom:1px solid #f0f0f0;color:#6b7280;text-align:right;">{{ log.count }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    {% endif %}
</div>

{% extends '@SyliusAdmin/shared/layout/base.html.twig' %}

{% block title %}Fullmetrix {{ parent() }}{% endblock %}

{% block body %}
<div style="min-height:100vh;background:#f6f7f9;padding:32px 16px;">
    <div style="max-width:720px;margin:0 auto;">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
            <h1 style="font-size:22px;font-weight:600;margin:0;color:#111827;">Fullmetrix</h1>
            <a href="{{ path('sylius_admin_dashboard') }}" style="font-size:13px;color:#6b7280;text-decoration:none;">Back to admin</a>
        </div>

        {% if registered %}
            <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px;margin-bottom:16px;">
                <div style="display:inline-flex;align-items:center;gap:8px;background:#ecfdf5;color:#047857;padding:6px 12px;border-radius:999px;font-size:13px;font-weight:500;margin-bottom:16px;">Connected</div>
                <table style="width:100%;font-size:14px;border-collapse:collapse;">
                    <tr><td style="padding:6px 0;color:#6b7280;">Connection code</td><td style="padding:6px 0;text-align:right;font-family:monospace;">{{ connection_code }}</td></tr>
                    <tr><td style="padding:6px 0;color:#6b7280;">Webhooks</td><td style="padding:6px 0;text-align:right;">{{ webhooks_enabled ? 'Enabled' : 'Disabled' }}</td></tr>
                    <tr><td style="padding:6px 0;color:#6b7280;">Last sync</td><td style="padding:6px 0;text-align:right;">{{ last_sync ?: 'Never' }}</td></tr>
                    <tr><td style="padding:6px 0;color:#6b7280;">Exports served</td><td style="padding:6px 0;text-align:right;">{{ export_count }}</td></tr>
                </table>
                <form action="{{ path('fullmetrix_admin_disconnect') }}" method="post" style="margin-top:16px;">
                    <button type="submit" style="background:#fff;border:1px solid #e5e7eb;color:#dc2626;padding:8px 16px;border-radius:8px;cursor:pointer;font-size:14px;">Disconnect</button>
                </form>
            </div>
        {% else %}
            <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px;margin-bottom:16px;">
                <p style="margin:0 0 16px;color:#374151;font-size:14px;">Enter the connection code from your Fullmetrix dashboard to connect this store.</p>
                {% if error %}
                    <div style="background:#fef2f2;color:#b91c1c;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:14px;">Connection failed: {{ error }}</div>
                {% endif %}
                <form action="{{ path('fullmetrix_admin_connection') }}" method="post" style="display:flex;gap:8px;">
                    <input type="text" name="connection_code" value="{{ submitted_code }}" placeholder="FMTX-XXXX-XXXX-XXXX" required style="flex:1;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-size:14px;font-family:monospace;" />
                    <button type="submit" style="background:#111827;color:#fff;border:0;padding:10px 20px;border-radius:8px;cursor:pointer;font-size:14px;font-weight:500;">Connect</button>
                </form>
            </div>
        {% endif %}

        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:24px;">
            <h2 style="font-size:15px;font-weight:600;margin:0 0 12px;color:#111827;">Recent activity</h2>
            {% if logs is empty %}
                <p style="color:#9ca3af;font-size:13px;margin:0;">No activity yet.</p>
            {% else %}
                <table style="width:100%;font-size:13px;border-collapse:collapse;">
                    <thead><tr style="text-align:left;color:#6b7280;border-bottom:1px solid #f3f4f6;">
                        <th style="padding:6px 0;">Time</th><th style="padding:6px 0;">Type</th><th style="padding:6px 0;">Message</th>
                    </tr></thead>
                    <tbody>
                    {% for log in logs %}
                        <tr style="border-bottom:1px solid #f9fafb;">
                            <td style="padding:6px 8px 6px 0;color:#6b7280;white-space:nowrap;">{{ log.created_at }}</td>
                            <td style="padding:6px 8px 6px 0;">{{ log.type }}</td>
                            <td style="padding:6px 0;">{{ log.message }}{% if log.count > 1 %} (x{{ log.count }}){% endif %}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

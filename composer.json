{
    "name": "fullmetrix/sylius-plugin",
    "type": "sylius-plugin",
    "description": "Fullmetrix connector for Sylius. Syncs orders, customers, products, promotions and tracks visitor events to Fullmetrix.",
    "license": "proprietary",
    "keywords": ["sylius", "sylius-plugin", "fullmetrix", "analytics", "marketing"],
    "homepage": "https://fullmetrix.com",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "sylius/sylius": "^1.13 || ^2.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "doctrine/orm": "^2.15 || ^3.0",
        "doctrine/doctrine-bundle": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-symfony": "^1.3",
        "phpstan/phpstan-doctrine": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "Fullmetrix\\SyliusPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fullmetrix\\SyliusPlugin\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
